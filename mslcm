################################################################################
# Function: ensure_vxlan_peers_fw_rule
# Description: Ensure datacenter IN rule for VXLAN UDP/4789 between vxlan peers.
#
# Main commands/functions used:
#   - pvesh get/create: Read/create datacenter firewall rules
#   - jq: Parse firewall rules JSON
################################################################################
ensure_vxlan_peers_fw_rule() {
    local rule_comment="MSLSetup VXLAN UDP/4789 Between VXLAN Peers"
    local pos

    pos="$(pvesh get /cluster/firewall/rules --output-format json 2>/dev/null | jq -r --arg c "$rule_comment" '.[] | select(.comment==$c) | .pos' | head -n1)"
    if [[ -n "$pos" ]]; then
        log_info "Datacenter FW rule already exists: ${rule_comment}"
        return 0
    fi

    pvesh create /cluster/firewall/rules \
        -action ACCEPT \
        -type in \
        -source "+dc/vxlan_peers" \
        -dest "+dc/vxlan_peers" \
        -proto udp \
        -dport 4789 \
        -enable 1 \
        -comment "$rule_comment" >/dev/null
    log_info "Created datacenter FW rule for VXLAN UDP/4789 between vxlan_peers"
}

