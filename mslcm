    local cmd="$1"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        log_error "Required command not found: $cmd"
        exit 1
    fi
}

################################################################################
# Function: check_cluster_state
# Description: Validate that the current host is in cluster state.
#
# Main commands/functions used:
#   - pvecm status: Query cluster status
#   - grep: Detect node lines beginning with 0x
################################################################################
check_cluster_state() {
    if ! pvecm status 2>&1| grep -q '^0x'; then
        log_info "Proxmox cluster has not been created on this node yet."
        log_info "'mslcm enable-cluster' can only be used after creating a cluster."
        log_info "After the cluster is created, run this command again on the initial node."
        exit 1
    fi
}

################################################################################
# Function: ensure_shared_env
# Description: Ensure /etc/pve/mslsetup/.env exists and load it.
#
# Main commands/functions used:
#   - test/source: Validate and load shared env file
#   - source: Load environment variables
################################################################################
ensure_shared_env() {
    mkdir -p "$STATE_DIR"

    if [[ ! -f "$SHARED_ENV" ]]; then
        log_error "$SHARED_ENV not found. Run 0103_clusterSetup.sh to provision shared env first."
        exit 1
    fi

    # shellcheck disable=SC1090
    source "$SHARED_ENV"

    local required=(NUM_PJ ML_CIDR ML_GW PVE_IP)
    local v
    for v in "${required[@]}"; do
        if [[ -z "${!v:-}" ]]; then
            log_error "Missing required variable in .env: $v"
            exit 1
        fi
    done
}

################################################################################
# Function: ipv4_to_int
# Description: Convert dotted IPv4 string to integer.
#
# Main commands/functions used:
#   - bash arithmetic: Convert octets to 32-bit integer
################################################################################
ipv4_to_int() {
    local ip="$1"
    local a b c d
    IFS='.' read -r a b c d <<< "$ip"
    printf '%u\n' "$(( (a << 24) + (b << 16) + (c << 8) + d ))"
}

################################################################################
# Function: ip_in_cidr
# Description: Validate if an IP belongs to a CIDR network.
#
# Main commands/functions used:
#   - ipcalc: Resolve network/broadcast
#   - bash arithmetic: Compare integer ranges
################################################################################
ip_in_cidr() {
    local ip="$1"
    local cidr="$2"
    local network broadcast calc_out

    calc_out="$(ipcalc "$cidr" 2>/dev/null || true)"
    network="$(printf '%s\n' "$calc_out" | awk '/^Network:/ {print $2; exit}' | cut -d/ -f1)"
    broadcast="$(printf '%s\n' "$calc_out" | awk '/^Broadcast:/ {print $2; exit}')"

    if [[ -z "$network" || -z "$broadcast" ]]; then
        network="$(ipcalc -n "$cidr" 2>/dev/null | awk -F= '/NETWORK/ {print $2; exit}' | cut -d/ -f1)"
        broadcast="$(ipcalc -b "$cidr" 2>/dev/null | awk -F= '/BROADCAST/ {print $2; exit}')"
    fi

    if [[ -z "$network" || -z "$broadcast" ]]; then
        log_error "Failed to resolve network/broadcast from CIDR: $cidr"
        return 1
    fi

    local ip_i net_i brd_i
    ip_i="$(ipv4_to_int "$ip")"
    net_i="$(ipv4_to_int "$network")"
    brd_i="$(ipv4_to_int "$broadcast")"

    [[ "$ip_i" -gt "$net_i" && "$ip_i" -lt "$brd_i" ]]
}

################################################################################
# Function: detect_main_interface
# Description: Detect main bridge interface based on PVE_IP.
#
# Main commands/functions used:
#   - ip: Enumerate IPv4 interfaces
#   - awk: Match interface by address
################################################################################
detect_main_interface() {
    local matches
    matches="$(ip -o -4 addr show | awk -v ip="$PVE_IP" '$4 ~ ("^" ip "/") {print $2}')"

    if [[ -z "$matches" ]]; then
        log_error "Unable to detect main interface from PVE_IP=$PVE_IP"
        exit 1
    fi

    local count
    count="$(printf '%s\n' "$matches" | wc -l)"
    if [[ "$count" -eq 1 ]]; then
        printf '%s\n' "$matches"
        return 0
    fi

    log_warn "Multiple interfaces match PVE_IP. Select one interface."
    local idx=1
    local arr=()
    while IFS= read -r line; do
        arr+=("$line")
        printf '  %d) %s\n' "$idx" "$line"
        idx=$((idx + 1))
    done <<< "$matches"

    local sel
    while true; do
        read -r -p "Select interface number: " sel
        if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#arr[@]} )); then
            printf '%s\n' "${arr[$((sel-1))]}"
            return 0
        fi
        log_warn "Invalid selection."
    done
}

################################################################################
# Function: choose_target_node
# Description: Determine add-node target IP by argument or interactive select.
#
# Main commands/functions used:
#   - pvecm status: Enumerate cluster members
#   - awk: Extract node IPs and remove local entry
################################################################################
choose_target_node() {
    local input_ip="${1:-}"
    if [[ -n "$input_ip" ]]; then
        printf '%s\n' "$input_ip"
        return 0
    fi

    mapfile -t candidates < <(pvecm status | awk '/^0x/ && $0 !~ /\(local\)/ {print $3}')

    if [[ "${#candidates[@]}" -eq 0 ]]; then
        log_error "No non-local cluster member found in pvecm status output."
        exit 1
    fi

    if [[ "${#candidates[@]}" -eq 1 ]]; then
        printf '%s\n' "${candidates[0]}"
        return 0
    fi

    log_info "Select target node IP:"
    local i=1
    for ip in "${candidates[@]}"; do
        printf '  %d) %s\n' "$i" "$ip"
        i=$((i + 1))
    done

    local sel
    while true; do
        read -r -p "Enter number: " sel
        if [[ "$sel" =~ ^[0-9]+$ ]] && (( sel >= 1 && sel <= ${#candidates[@]} )); then
            printf '%s\n' "${candidates[$((sel-1))]}"
            return 0
        fi
        log_warn "Invalid selection."
    done
}

################################################################################
# Function: assert_target_is_cluster_member
# Description: Ensure target IP exists in current cluster membership and is not local.
#
# Main commands/functions used:
#   - pvecm status: Read cluster member list
#   - awk/grep: Validate target membership and local flag
################################################################################
assert_target_is_cluster_member() {
    local target_ip="$1"

    if ! pvecm status | awk '/^0x/ {print $3}' | grep -Fxq "$target_ip"; then
        log_error "Target node(${target_ip}) is not a current cluster member."
        log_error "Join the node to cluster first (pvecm add), then run add-node."
        exit 1
    fi

    if pvecm status | awk '/^0x/ && /\(local\)/ {print $3}' | grep -Fxq "$target_ip"; then
        log_error "Target IP is the local node. Specify a non-local cluster member."
        exit 1
    fi
}

################################################################################
# Function: calc_priority_from_nodeid
# Description: Calculate keepalived priority from target nodeid in pvecm status.
#
# Main commands/functions used:
#   - pvecm status: Read member nodeid and IP mapping
#   - awk: Extract hex nodeid for target IP
#   - bash arithmetic: Compute priority formula
################################################################################
calc_priority_from_nodeid() {
    local target_ip="$1"
    local nodeid_hex nodeid_dec priority

    nodeid_hex="$(pvecm status | awk -v ip="$target_ip" '/^0x/ && $3==ip {print $1; exit}')"
    if [[ -z "$nodeid_hex" ]]; then
        log_error "Failed to resolve nodeid from pvecm status for target IP: $target_ip"
        exit 1
    fi

    nodeid_dec=$((16#${nodeid_hex#0x}))
    priority=$((100 - (nodeid_dec - 1) * 20))

    if (( priority < 1 )); then
        log_warn "Calculated priority ${priority} is below 1; clamping to 1"
        priority=1
    fi

    printf '%s\n' "$priority"
}

################################################################################
# Function: ensure_vxlan_peers_ipset
# Description: Ensure datacenter IPSet vxlan_peers exists.
#
# Main commands/functions used:
#   - pvesh get/create: Read/create datacenter IPSet
#   - jq: Parse IPSet list JSON
################################################################################
ensure_vxlan_peers_ipset() {
    local exists
    exists="$(pvesh get /cluster/firewall/ipset --output-format json 2>/dev/null | jq -r '.[] | select(.name=="vxlan_peers") | .name' | head -n1)"
    if [[ "$exists" == "vxlan_peers" ]]; then
        log_info "IPSet vxlan_peers already exists."
        return 0
    fi

    pvesh create /cluster/firewall/ipset \
        -name vxlan_peers \
        -comment "MSLSetup Cluster VXLAN peer nodes" >/dev/null
    log_info "Created IPSet vxlan_peers"
}

