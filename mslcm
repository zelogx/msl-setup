################################################################################
# Function: remove_zone_peers
# Description: Remove target node IP from vpndmz and all devpjXX zone peer lists.
#
# Main commands/functions used:
#   - pvesh/jq: Read/update SDN zone peers
################################################################################
remove_zone_peers() {
    local node_ip="$1"
    local json peers new_peers

    # Remove from vpndmz zone peers first
    json="$(pvesh get "/cluster/sdn/zones/vpndmz" --output-format json 2>/dev/null || true)"
    if [[ -n "$json" ]]; then
        peers="$(printf '%s' "$json" | jq -r '.peers // ""')"
        if printf ',%s,' "$peers" | grep -q ",${node_ip},"; then
            new_peers="$(printf '%s' "$peers" | tr ',' '\n' | sed '/^$/d' | awk -v n="$node_ip" '$0!=n' | awk '!seen[$0]++' | paste -sd ',' -)"
            pvesh set "/cluster/sdn/zones/vpndmz" -peers "$new_peers" >/dev/null
            log_info "Zone vpndmz: removed peer ${node_ip} -> ${new_peers}"
        else
            log_info "Zone vpndmz: peer ${node_ip} not present; skipping"
        fi
    else
        log_warn "Zone vpndmz not found; skipping peer removal"
    fi

    for i in $(seq 1 "$NUM_PJ"); do
        local idx zone
        idx=$(printf '%02d' "$i")
        zone="devpj${idx}"

        json="$(pvesh get "/cluster/sdn/zones/${zone}" --output-format json 2>/dev/null || true)"
        [[ -n "$json" ]] || continue

        peers="$(printf '%s' "$json" | jq -r '.peers // ""')"
        if [[ -z "$peers" ]]; then
            continue
        fi

        if ! printf ',%s,' "$peers" | grep -q ",${node_ip},"; then
            continue
        fi

        new_peers="$(printf '%s' "$peers" | tr ',' '\n' | sed '/^$/d' | awk -v n="$node_ip" '$0!=n' | awk '!seen[$0]++' | paste -sd ',' -)"
        pvesh set "/cluster/sdn/zones/${zone}" -peers "$new_peers" >/dev/null
        log_info "Zone ${zone}: removed peer ${node_ip} -> ${new_peers}"
    done

    pvesh set /cluster/sdn >/dev/null
    log_info "SDN apply completed after peer removals."
}

################################################################################
# Function: restore_local_gateway_backend
# Description: Remove cluster-mode no-op patch from mslsetup-vxlan-gw hooks.
#
# Main commands/functions used:
#   - awk: Remove injected marker + immediate exit 0 lines
################################################################################
restore_local_gateway_backend() {
    local hook
    local tmp
    local marker="# mslcm-cluster-disable-vnetpj"

    for hook in /etc/network/if-up.d/mslsetup-vxlan-gw /etc/network/if-down.d/mslsetup-vxlan-gw; do
        [[ -f "$hook" ]] || continue

        if ! grep -Fq "$marker" "$hook"; then
            continue
        fi

        tmp="${hook}.tmp"
        awk -v m="$marker" '
            skip_next_exit == 1 {
                if ($0 ~ /^exit 0$/) {
                    skip_next_exit=0
                    next
                }
                skip_next_exit=0
            }
            $0 == m {
                skip_next_exit=1
                next
            }
            { print }
        ' "$hook" > "$tmp"
        mv "$tmp" "$hook"
        chmod 0755 "$hook"
    done

    if command -v ifreload >/dev/null 2>&1; then
        ifreload -a
    fi

    log_info "Restored local mslsetup-vxlan-gw hooks by removing cluster no-op patch"
}

################################################################################
# Function: ensure_packages_local
# Description: Install keepalived and arping if missing on local node.
#
# Main commands/functions used:
#   - apt-get: Install packages
#   - command: Check executable presence
################################################################################
ensure_packages_local() {
    if command -v keepalived >/dev/null 2>&1 && command -v arping >/dev/null 2>&1; then
        return 0
    fi
    log_info "Installing keepalived and arping on local node..."
    apt-get update -y >/dev/null 2>&1
    apt-get install -y keepalived arping >/dev/null 2>&1
}

################################################################################
# Function: remove_packages_local
# Description: Remove keepalived stack and unused related dependencies locally.
#
# Main commands/functions used:
#   - apt-get: Purge packages and autoremove orphaned dependencies
################################################################################
remove_packages_local() {
    log_info "Removing keepalived and arping on local node..."
    DEBIAN_FRONTEND=noninteractive apt-get purge -y keepalived arping >/dev/null 2>&1 \
        || DEBIAN_FRONTEND=noninteractive apt-get remove -y keepalived arping >/dev/null 2>&1 \
        || true

    # Remove dependencies that became unnecessary after keepalived purge.
    DEBIAN_FRONTEND=noninteractive apt-get autoremove -y --purge >/dev/null 2>&1 || true
}

################################################################################
# Function: write_cluster_env
# Description: Persist cluster runtime variables used by vip hook.
