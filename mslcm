################################################################################
# Function: remove_vxlan_peer_entry
# Description: Remove target node IP from vxlan_peers IPSet if present.
#
# Main commands/functions used:
#   - pvesh get/delete: Read/delete IPSet entries
#   - jq: Parse IPSet entry JSON
################################################################################
remove_vxlan_peer_entry() {
    local peer_ip="$1"
    local peer_cidr="${peer_ip}/32"
    local exists cidr_encoded

    # vxlan_peers may already be removed on repeated del-node runs; treat as empty.
    exists="$(pvesh get /cluster/firewall/ipset/vxlan_peers --output-format json 2>/dev/null | jq -r --arg ip "$peer_ip" --arg c "$peer_cidr" '.[] | select(.cidr==$ip or .cidr==$c) | .cidr' | head -n1 || true)"
    if [[ -z "$exists" ]]; then
        log_info "IPSet vxlan_peers does not contain ${peer_ip} or ${peer_cidr}; skipping delete"
        return 0
    fi

    cidr_encoded="${exists//\//%2F}"
    pvesh delete "/cluster/firewall/ipset/vxlan_peers/${cidr_encoded}" >/dev/null
    log_info "Removed ${exists} from IPSet vxlan_peers"
}

################################################################################
# Function: cleanup_vxlan_peers_ipset_if_empty
# Description: Delete vxlan_peers IPSet when no entries remain.
#
# Main commands/functions used:
#   - pvesh get/delete: Read/delete IPSet
#   - jq: Count IPSet entries
################################################################################
cleanup_vxlan_peers_ipset_if_empty() {
    local count
    count="$(pvesh get /cluster/firewall/ipset/vxlan_peers --output-format json 2>/dev/null | jq 'length' 2>/dev/null || echo 0)"
    if [[ "$count" -eq 0 ]]; then
        pvesh delete /cluster/firewall/ipset/vxlan_peers >/dev/null 2>&1 || true
        log_info "Deleted empty IPSet vxlan_peers"
    fi
}

