################################################################################
# Function: remove_backup_entry_from_cluster_env
# Description: Remove BACKUP entry for target node IP from cluster.env.
#
# Main commands/functions used:
#   - awk: Filter out matching BACKUP line
#   - mv: Atomically replace cluster.env
################################################################################
remove_backup_entry_from_cluster_env() {
    local target_ip="$1"
    local target_line="BACKUP=${target_ip}"
    local tmp_file

    if [[ ! -f "$CLUSTER_ENV" ]]; then
        log_info "cluster.env not found; skipping BACKUP entry cleanup for ${target_ip}"
        return 0
    fi

    if ! grep -Fxq "$target_line" "$CLUSTER_ENV"; then
        log_info "cluster.env does not contain BACKUP entry for ${target_ip}; skipping"
        return 0
    fi

    tmp_file="$(mktemp "${STATE_DIR}/.cluster.env.tmp.XXXXXX")"
    awk -v line="$target_line" '$0 != line { print }' "$CLUSTER_ENV" > "$tmp_file"
    mv "$tmp_file" "$CLUSTER_ENV"
    log_info "Removed BACKUP entry from cluster.env: ${target_ip}"
}

