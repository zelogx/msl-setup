mkdir -p /etc/motd.d
rm -f "$WARN_FILE"
if [[ -d /etc/motd.d ]]; then
    rm -f "$MOTD_FILE"
fi

ip2int() {
    local IFS=. a b c d
    read -r a b c d <<<"$1"
    printf '%u\n' $(( (a << 24) + (b << 16) + (c << 8) + d ))
}

int2ip() {
    local n=$1
    printf '%u.%u.%u.%u\n' \
        $(( (n >> 24) & 255 )) \
        $(( (n >> 16) & 255 )) \
        $(( (n >> 8) & 255 )) \
        $(( n & 255 ))
}

append_warning() {
    local message="$1"
    printf '%s\n' "$message" >>"$WARN_FILE"
    echo "WARNING: $message" >&2
    logger -t msl-dhcp -- "WARNING: $message" || true
}

emit_range() {
    local start_n=$1 end_n=$2
    (( start_n <= end_n )) || return 0
    echo "dhcp-range=$(int2ip "$start_n"),$(int2ip "$end_n"),${NETMASK},12h"
}

ct_n=$(ip2int "$CT_IP")
effective_count=0
conflict_count=0

{
    echo '# Generated from Proxmox SDN settings. Do not edit.'
    echo '# If CT_IP overlaps with a DHCP pool, the renderer excludes CT_IP from the effective dnsmasq range.'
    echo 'port=0'
    echo 'interface=eth0'
    echo 'bind-dynamic'
    echo 'except-interface=lo'
    echo 'dhcp-authoritative'
    echo 'dhcp-rapid-commit'
    echo 'log-dhcp'
    echo 'dhcp-option=option:router,'"$GATEWAY"
    echo 'dhcp-option=option:dns-server,'"$DHCP_DNS"
    IFS=',' read -r -a ranges <<<"$DHCP_RANGES"
    for range in "${ranges[@]}"; do
        start="${range%-*}"
        end="${range#*-}"
        start_n=$(ip2int "$start")
        end_n=$(ip2int "$end")
        if (( start_n > end_n )); then
            echo "Invalid DHCP range: ${start}-${end}" >&2
            exit 1
        fi

        if (( ct_n < start_n || ct_n > end_n )); then
            emit_range "$start_n" "$end_n"
            ((effective_count+=1))
            continue
        fi

        ((conflict_count+=1))
        echo "# WARNING: CT_IP ${CT_IP} was inside DHCP range ${start}-${end}; excluded from effective range."
        append_warning "CT_IP ${CT_IP} is inside DHCP range ${start}-${end}; excluded it from the effective dnsmasq DHCP range. Reserve the DHCP CT IP outside the Proxmox SDN DHCP pool."

        if (( start_n <= ct_n - 1 )); then
            emit_range "$start_n" "$((ct_n - 1))"
            ((effective_count+=1))
        fi
        if (( ct_n + 1 <= end_n )); then
            emit_range "$((ct_n + 1))" "$end_n"
            ((effective_count+=1))
        fi
    done
} >"$tmp"

if (( conflict_count > 0 )); then
    {
        echo 'MSL DHCP warning'
        echo
        cat "$WARN_FILE"
    } >"${WARN_FILE}.tmp"
    mv -f "${WARN_FILE}.tmp" "$WARN_FILE"
    chmod 0644 "$WARN_FILE"
    if [[ -d /etc/motd.d ]]; then
        cp -f "$WARN_FILE" "$MOTD_FILE"
        chmod 0644 "$MOTD_FILE"
    fi
fi

if (( effective_count == 0 )); then
    append_warning "No effective DHCP range remains after excluding CT_IP ${CT_IP}. dnsmasq will run, but this VNet has no DHCP addresses to lease."
fi

chmod 0644 "$tmp"
mv -f "$tmp" "$OUT"
trap - EXIT

dnsmasq --test
SCRIPT
chmod 0755 /usr/local/sbin/msl-render-dnsmasq

cat >/etc/systemd/system/msl-render-dnsmasq.service <<'UNIT'
