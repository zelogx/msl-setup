DROPIN
EOF_RENDER

# Harden firewall: input UDP/67 only. DNS is disabled in dnsmasq (port=0).
pct exec "$VMID" -- bash -s <<'EOF_FW'
set -Eeuo pipefail

cat >/etc/nftables.conf <<'NFT'
#!/usr/sbin/nft -f
flush ruleset

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        iifname "lo" accept
        ct state established,related accept

        # DHCP client -> server. Source can be 0.0.0.0 and destination broadcast.
        iifname "eth0" udp sport 68 udp dport 67 accept

        # Everything else, including SSH, ICMP and IPv6 input, is dropped.
        counter drop
    }

    chain forward {
        type filter hook forward priority filter; policy drop;
    }

    chain output {
        type filter hook output priority filter; policy accept;
    }
}
NFT

systemctl enable nftables
systemctl restart nftables

# Ensure no SSH server is present/enabled.
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
systemctl disable --now ssh.service sshd.service ssh.socket postfix.service exim4.service 2>/dev/null || true
apt-get purge -y openssh-server ssh postfix exim4-base exim4-daemon-light 2>/dev/null || true
apt-get autoremove -y 2>/dev/null || true

systemctl daemon-reload
systemctl enable msl-render-dnsmasq.service
systemctl enable msl-dhcp-source.path
systemctl enable dnsmasq.service
/usr/local/sbin/msl-render-dnsmasq
systemctl restart dnsmasq
systemctl start msl-dhcp-source.path
EOF_FW

# Host-side singleton export after SDN Apply. The host unit only updates
# /var/lib/mslsetup/dhcp/<vnet>/dhcp.env files; each CT watches its own mount and
# restarts dnsmasq itself. Do not create per-VNet or per-VMID host units.
# The trigger is /etc/network/interfaces.d/sdn, not /etc/pve/sdn/subnets.cfg,
# so DHCP CTs reflect applied SDN configuration, not GUI-pending changes.
if [[ ! -f "/etc/systemd/system/${SERVICE_NAME}" ]]; then
    cat >"/etc/systemd/system/${SERVICE_NAME}" <<EOF_SERVICE
[Unit]
Description=Export Proxmox SDN DHCP settings for all MSL DHCP VNets

[Service]
Type=oneshot
ExecStart=${EXPORTER_SCRIPT}
