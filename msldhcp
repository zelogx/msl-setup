#!/usr/bin/env bash
set -Eeuo pipefail

SOURCE=/opt/msl-dhcp-source/dhcp.env
OUT=/etc/dnsmasq.d/msl-vnet-dhcp.conf

[[ -r "$SOURCE" ]] || {
    echo "DHCP source is not readable: $SOURCE" >&2
    exit 1
