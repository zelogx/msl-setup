Useful checks:
  pct console $VMID
  pct exec $VMID -- systemctl status dnsmasq nftables
  pct exec $VMID -- journalctl -u dnsmasq -f
  pct exec $VMID -- systemctl status msl-dhcp-source.path msl-apply-dnsmasq.service
