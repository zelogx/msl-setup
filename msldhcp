# Read-only mount containing only this VNet's exported DHCP settings.
pct set "$VMID" --mp0 "${STATE_DIR},mp=/opt/msl-dhcp-source,ro=1"

log "Starting CT for package installation..."
pct start "$VMID"

# Wait for systemd and network.
for _ in $(seq 1 60); do
