Description=Watch read-only DHCP export and refresh dnsmasq
RequiresMountsFor=/opt/msl-dhcp-source

[Path]
# Watch both the file and the directory. The host updates dhcp.env with an
# atomic rename, so watching the directory makes rename-based updates visible.
PathChanged=/opt/msl-dhcp-source/dhcp.env
