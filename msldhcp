Description=Watch Proxmox SDN applied configuration for MSL DHCP exports

[Path]
PathChanged=/etc/network/interfaces.d/sdn
PathModified=/etc/network/interfaces.d/sdn
Unit=${SERVICE_NAME}

[Install]
WantedBy=multi-user.target
