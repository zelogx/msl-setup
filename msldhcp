#!/usr/bin/env bash
set -Eeuo pipefail

# deploy-vnet-dhcp-ct-v9-strict-api.sh
# Deploy a dedicated DHCP-only LXC container for a Proxmox SDN VNet.
#
# Tested design target: Proxmox VE 9.x
# DHCP source: Datacenter > SDN > VNets > Subnets
#
# The host extracts only the selected VNet's DHCP settings into:
#   /var/lib/mslsetup/dhcp/<vnet>/dhcp.env
# The directory is mounted read-only inside the CT.
# /etc/pve is used only as the Proxmox SDN source and is not bind-mounted.
#
# A systemd path unit watches Proxmox SDN subnet configuration and
# automatically refreshes the exported DHCP state when the GUI settings change.
# The CT watches the read-only exported dhcp.env and restarts dnsmasq itself.

PROG="${0##*/}"

VMID=""
VNET=""
BRIDGE=""
NODE="$(hostname -s)"
ROOTFS_STORAGE=""
TEMPLATE_STORAGE=""
TEMPLATE_REGEX='debian-13-standard_.*_amd64\.tar\.(zst|xz|gz)$'
HOSTNAME_CT=""
CT_IP=""
CT_PREFIX=""
CT_GATEWAY=""
CT_USER=""
CT_USER_SPECIFIED="no"
CT_PASSWORD_ARG=""
ROOTFS_SIZE_GB="1"
MEMORY_MB="256"
SWAP_MB="128"
CORES="1"
DNS_SERVER=""
START_CT="yes"
UNPRIVILEGED="1"
FORCE="no"

usage() {
    cat <<EOF
Usage:
        $PROG [--vmid ID] [--vnet VNET] [options]

Main options:
    --vmid ID                  LXC VMID. If omitted, prompt after VNet selection.
    --vnet NAME                SDN VNet name, e.g. vnetpj05 (optional)

Authentication / console:
    --user NAME                Optional debug console user.
                                                         If omitted, no user/password is created
                                                         (debug with 'pct exec' only).
    --password PASS            Required only when --user is specified.
                                                         Can also be provided via CT_PASSWORD environment variable.

Network:
  --bridge NAME              CT bridge (default: same as --vnet)
  --ct-ip IP[/PREFIX]        Static CT IP. If omitted, select a usable address
                             outside the DHCP pool.
  --gateway IP               Override subnet gateway
    --dns-server IPS           CT resolver list for package install.
                                                         Accepts one IP or a quoted space-separated list.
                                                         (default: MSL_HOST_DNS_SERVERS or host
                                                         /etc/resolv.conf nameservers)
  --node NAME                Deployment node (default: local node)

Storage / template:
    --rootfs-storage NAME      CT rootfs storage. If omitted, auto/prompt select
                                                         from storages supporting 'rootdir'.
    --template-storage NAME    Template storage.
                                                         If omitted, auto/prompt select from storages
                                                         supporting 'vztmpl'.
  --template-regex REGEX     pveam template filename regex
                             (default: latest Debian 13 standard amd64)
  --rootfs-size GB           Rootfs size in GB (default: 2)

Resources:
  --memory MB                RAM (default: 256)
  --swap MB                  Swap (default: 128)
  --cores N                  CPU cores (default: 1)

Behavior:
  --no-start                 Create/configure but leave stopped
  --privileged               Create a privileged CT (default: unprivileged)
  --force                    Destroy an existing CT with the same VMID
  -h, --help                 Show this help

Example:
    CT_PASSWORD='temporary-console-password' $PROG \
    --vmid 905 \
    --vnet vnetpj05 \
    --rootfs-storage local-lvm \
    --template-storage local \
    --user dhcpdebug
EOF
}

log()  { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
warn() { printf '[%s] WARNING: %s\n' "$(date '+%F %T')" "$*" >&2; }
die()  { printf '[%s] ERROR: %s\n' "$(date '+%F %T')" "$*" >&2; exit 1; }

need_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }

vmid_resource_type() {
    local vmid="$1"

    if pct status "$vmid" >/dev/null 2>&1; then
        printf '%s\n' "lxc"
        return 0
    fi
    if qm status "$vmid" >/dev/null 2>&1; then
        printf '%s\n' "qemu"
        return 0
    fi

    return 1
}

vmid_is_available() {
    local vmid="$1"

    ! vmid_resource_type "$vmid" >/dev/null 2>&1
}

prompt_available_vmid() {
    local sel sel_normalized sel_num vmid_type

    while true; do
        printf 'Enter VMID for DHCP CT: ' >&2
        if ! IFS= read -r sel < /dev/tty; then
            die "Unable to read VMID from terminal. Specify --vmid explicitly."
        fi

        # Normalize full-width digits (e.g., ２) to ASCII before numeric checks.
        sel_normalized=$(printf '%s' "$sel" | sed 'y/０１２３４５６７８９/0123456789/')

        if ! [[ "$sel_normalized" =~ ^[0-9]+$ ]]; then
            warn "Invalid VMID. Enter digits only."
            continue
        fi

        sel_num=$((10#$sel_normalized))
        if vmid_is_available "$sel_num"; then
            printf '%s\n' "$sel_num"
            return 0
        fi

        vmid_type="$(vmid_resource_type "$sel_num" || true)"
        warn "VMID ${sel_num} is already in use${vmid_type:+ by ${vmid_type}}. Please choose another VMID."
    done
}

storage_supports_content() {
    local storage_name="$1"
    local content_type="$2"
    local storage_json content

    storage_json=$(pvesh get /storage --output-format json 2>/dev/null) || return 1
    content=$(printf '%s\n' "$storage_json" | jq -r --arg s "$storage_name" '.[] | select(.storage == $s) | (.content // "")' | head -n1)
    [[ -n "$content" ]] || return 1

    [[ ",$content," =~ ,${content_type}, ]]
}

select_storage_for_content() {
    local content_type="$1"
    local storage_role="$2"
    local storage_json
    local choices=()
    local i sel

    printf '[%s] Querying selectable storages for %s (content: %s)...\n' "$(date '+%F %T')" "$storage_role" "$content_type" >&2
    storage_json=$(pvesh get /storage --output-format json 2>/dev/null) || true
    [[ -n "$storage_json" ]] || die "Failed to query storage list via pvesh for ${storage_role}."

    mapfile -t choices < <(printf '%s\n' "$storage_json" | jq -r --arg c "$content_type" '.[] | select((.enabled==1) or (.enabled? == null)) | select((.content // "") | test("(^|,)" + $c + "(,|$)")) | .storage' 2>/dev/null || true)

    if [[ ${#choices[@]} -eq 0 ]]; then
        die "No available storage found for ${storage_role} (required content type: ${content_type})."
    elif [[ ${#choices[@]} -eq 1 ]]; then
        printf '[%s] Auto-selected %s: %s\n' "$(date '+%F %T')" "$storage_role" "${choices[0]}" >&2
        printf '%s\n' "${choices[0]}"
        return 0
    fi

    echo "Multiple storages are available for ${storage_role} (${content_type}):" >&2
    i=1
    for s in "${choices[@]}"; do
        echo "  ${i}) ${s}" >&2
        i=$((i + 1))
    done

    while true; do
        local sel_normalized sel_num
        printf 'Select %s storage (1-%s): ' "${storage_role}" "${#choices[@]}" >&2
        if ! IFS= read -r sel < /dev/tty; then
            warn "Unable to read from terminal for ${storage_role} selection."
            return 1
        fi

        # Normalize full-width digits (e.g., ２) to ASCII before numeric checks.
        sel_normalized=$(printf '%s' "$sel" | sed 'y/０１２３４５６７８９/0123456789/')

        if [[ "$sel_normalized" =~ ^[0-9]+$ ]]; then
            sel_num=$((10#$sel_normalized))
            if (( sel_num >= 1 && sel_num <= ${#choices[@]} )); then
                printf '%s\n' "${choices[$((sel_num - 1))]}"
                return 0
            fi
        fi

        warn "Invalid selection. Please select 1-${#choices[@]}."
    done
}

validate_ipv4() {
    python3 - "$1" <<'PY'
import ipaddress, sys
try:
    ipaddress.IPv4Address(sys.argv[1])
except Exception:
    raise SystemExit(1)
PY
}

validate_nameserver_list() {
    local nameserver_list="$1"
    local nameserver

    read -r -a nameservers <<<"$nameserver_list"
    ((${#nameservers[@]} > 0)) || return 1

    for nameserver in "${nameservers[@]}"; do
        validate_ipv4 "$nameserver" || return 1
    done
}

load_host_dns_servers() {
    local resolv_file="/etc/resolv.conf"
    local host_dns

    [[ -r "$resolv_file" ]] || return 1
    host_dns=$(awk '/^[[:space:]]*nameserver[[:space:]]+/ {print $2}' "$resolv_file" 2>/dev/null | awk 'NF' | xargs || true)
    [[ -n "$host_dns" ]] || return 1
    printf '%s\n' "$host_dns"
}

resolve_vnet_selection() {
    local requested_vnet="$1"

    python3 - "$requested_vnet" <<'PY'
import json
import subprocess
import sys

requested = sys.argv[1].strip()


def run_json(path):
    p = subprocess.run(
        ["pvesh", "get", path, "--output-format", "json"],
        check=True, text=True, encoding="utf-8", errors="replace", stdout=subprocess.PIPE
    )
    return json.loads(p.stdout)


def as_rows(data):
    if isinstance(data, list):
        return data
    if data is None:
        return []
    return [data]


def first_non_empty(row, keys):
    for key in keys:
        value = row.get(key)
        if value not in (None, ""):
            return str(value)
    return ""


def parse_dhcp_ranges(row, vnet_name):
    if "dhcp-range" not in row or row.get("dhcp-range") in (None, []):
        return []
    value = row.get("dhcp-range")
    subnet_id = first_non_empty(row, ("subnet", "id")) or "unknown-subnet"
    if not isinstance(value, list):
        raise ValueError(
            f"Unsupported DHCP range format on {vnet_name}/{subnet_id}: expected dhcp-range to be a list of objects."
        )
    out = []
    for idx, item in enumerate(value, start=1):
        if not isinstance(item, dict):
            raise ValueError(
                f"Unsupported DHCP range item on {vnet_name}/{subnet_id} at index {idx}: expected object with start-address and end-address."
            )
        start = item.get("start-address")
        end = item.get("end-address")
        if not isinstance(start, str) or not isinstance(end, str) or not start or not end:
            raise ValueError(
                f"Unsupported DHCP range item on {vnet_name}/{subnet_id} at index {idx}: expected string start-address and end-address."
            )
        out.append((start, end))
    return out


def load_catalog():
    vnet_rows = as_rows(run_json("/cluster/sdn/vnets"))
    zone_rows = as_rows(run_json("/cluster/sdn/zones"))

    zones = {}
    for row in zone_rows:
        if not isinstance(row, dict):
            continue
        zone_name = first_non_empty(row, ("zone", "zoneid", "id"))
        if zone_name:
            zones[zone_name] = row

    catalog = []
    for row in vnet_rows:
        if not isinstance(row, dict):
            continue
        name = first_non_empty(row, ("vnet", "vnetid", "id"))
        if not name:
            continue
        zone_name = first_non_empty(row, ("zone", "zoneid", "zone-name"))
        zone_row = zones.get(zone_name, {})
        zone_type = first_non_empty(zone_row, ("type", "zone_type", "zone-type"))

        dhcp_subnet_count = 0
        try:
            subnet_rows = as_rows(run_json(f"/cluster/sdn/vnets/{name}/subnets"))
        except Exception:
            subnet_rows = []
        for subnet_row in subnet_rows:
            if isinstance(subnet_row, dict) and parse_dhcp_ranges(subnet_row, name):
                dhcp_subnet_count += 1

        catalog.append({
            "name": name,
            "zone_type": zone_type,
            "dhcp_subnet_count": dhcp_subnet_count,
            "managed": zone_type == "vxlan" and name.startswith("vnetpj"),
        })

    return catalog


catalog = load_catalog()
requested_entry = None
managed = []
dhcp_ready = []

for entry in catalog:
    if requested and entry["name"] == requested:
        requested_entry = entry
    if entry["managed"]:
        managed.append(entry)
        if entry["dhcp_subnet_count"] > 0:
            dhcp_ready.append(entry)

if requested:
    if requested_entry is None or not requested_entry["managed"]:
        raise SystemExit(
            f"Selected VNet '{requested}' is not an MSL Setup-managed VXLAN zone."
        )
    if requested_entry["dhcp_subnet_count"] == 0:
        raise SystemExit(
            f"Selected VNet '{requested}' is managed by MSL Setup, but DHCP Range is not configured. Please check Datacenter > SDN and set the DHCP Range."
        )
    print(requested_entry["name"])
    raise SystemExit(0)

if not managed:
    raise SystemExit(
        "No VNet matched the MSL Setup VXLAN filter (zone type must be vxlan and VNet name must start with vnetpj). This VNet is not an MSL Setup-managed VXLAN zone."
    )

if not dhcp_ready:
    raise SystemExit(
        "No MSL Setup-managed VXLAN VNet has a configured DHCP range. This VNet is managed by MSL Setup, but DHCP Range is not configured. Please check Datacenter > SDN and set the DHCP Range."
    )

if len(dhcp_ready) == 1:
    print(dhcp_ready[0]["name"])
    raise SystemExit(0)

print("Multiple VNets match the MSL Setup filter:", file=sys.stderr)
for idx, entry in enumerate(dhcp_ready, start=1):
    print(f"  {idx}) {entry['name']}", file=sys.stderr)

while True:
    print(f"Select a VNet (1-{len(dhcp_ready)}): ", end="", file=sys.stderr, flush=True)
    try:
        with open("/dev/tty", "r", encoding="utf-8", errors="ignore") as tty:
            choice = tty.readline().strip()
    except EOFError:
        raise SystemExit(1)
    except OSError:
        raise SystemExit(1)
    if choice.isdigit():
        selected = int(choice)
        if 1 <= selected <= len(dhcp_ready):
            print(dhcp_ready[selected - 1]["name"])
            raise SystemExit(0)
    print(f"Invalid selection. Please choose 1-{len(dhcp_ready)}.", file=sys.stderr)
PY
}

while (($#)); do
    case "$1" in
        --vmid)              VMID="${2:?}"; shift 2 ;;
        --vnet)              VNET="${2:?}"; shift 2 ;;
        --bridge)            BRIDGE="${2:?}"; shift 2 ;;
        --node)              NODE="${2:?}"; shift 2 ;;
        --rootfs-storage)    ROOTFS_STORAGE="${2:?}"; shift 2 ;;
        --template-storage)  TEMPLATE_STORAGE="${2:?}"; shift 2 ;;
        --template-regex)    TEMPLATE_REGEX="${2:?}"; shift 2 ;;
        --hostname)          HOSTNAME_CT="${2:?}"; shift 2 ;;
        --ct-ip)             CT_IP="${2:?}"; shift 2 ;;
        --gateway)           CT_GATEWAY="${2:?}"; shift 2 ;;
        --dns-server)        DNS_SERVER="${2:?}"; shift 2 ;;
        --user)              CT_USER="${2:?}"; CT_USER_SPECIFIED="yes"; shift 2 ;;
        --password)          CT_PASSWORD_ARG="${2:?}"; shift 2 ;;
        --rootfs-size)       ROOTFS_SIZE_GB="${2:?}"; shift 2 ;;
        --memory)            MEMORY_MB="${2:?}"; shift 2 ;;
        --swap)              SWAP_MB="${2:?}"; shift 2 ;;
        --cores)             CORES="${2:?}"; shift 2 ;;
        --no-start)          START_CT="no"; shift ;;
        --privileged)        UNPRIVILEGED="0"; shift ;;
        --force)             FORCE="yes"; shift ;;
        -h|--help)           usage; exit 0 ;;
        *)                   die "Unknown argument: $1" ;;
    esac
done

[[ $EUID -eq 0 ]] || die "Run as root on a Proxmox VE node."
CT_PASSWORD_EFFECTIVE="${CT_PASSWORD_ARG:-${CT_PASSWORD:-}}"
if [[ "$CT_USER_SPECIFIED" == "yes" ]]; then
    [[ -n "$CT_PASSWORD_EFFECTIVE" ]] || die "--user requires --password or CT_PASSWORD environment variable."
    [[ "$CT_USER" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "Invalid user name."
fi

if [[ -n "$VMID" ]]; then
    is_uint "$VMID" || die "Invalid VMID: $VMID"
    VMID="$((10#$VMID))"
fi
is_uint "$ROOTFS_SIZE_GB" || die "Invalid --rootfs-size."
is_uint "$MEMORY_MB" || die "Invalid --memory."
is_uint "$SWAP_MB" || die "Invalid --swap."
is_uint "$CORES" || die "Invalid --cores."
if [[ -n "$VNET" ]]; then
    [[ "$VNET" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$ ]] || die "Invalid VNet name."
fi

for cmd in pvesh pct qm pveam pvesm jq python3 systemctl; do
    need_cmd "$cmd"
done

VNET="$(resolve_vnet_selection "$VNET")"

if [[ -z "$VMID" ]]; then
    log "--vmid was not specified; prompting for an available VMID after VNet selection."
    VMID="$(prompt_available_vmid)"
fi

BRIDGE="${BRIDGE:-$VNET}"
HOSTNAME_CT="${HOSTNAME_CT:-dhcp-${VNET}}"

if [[ -z "$ROOTFS_STORAGE" ]]; then
    ROOTFS_STORAGE="$(select_storage_for_content "rootdir" "rootfs")"
else
    storage_supports_content "$ROOTFS_STORAGE" "rootdir" \
        || die "Storage '${ROOTFS_STORAGE}' cannot be used for rootfs (required content type: rootdir)."
fi

if [[ -z "$TEMPLATE_STORAGE" ]]; then
    TEMPLATE_STORAGE="$(select_storage_for_content "vztmpl" "template")"
else
    storage_supports_content "$TEMPLATE_STORAGE" "vztmpl" \
        || die "Storage '${TEMPLATE_STORAGE}' cannot be used for template (required content type: vztmpl)."
fi

pvesm status --storage "$ROOTFS_STORAGE" >/dev/null 2>&1 \
    || die "Rootfs storage not found or unavailable: $ROOTFS_STORAGE"
pvesm status --storage "$TEMPLATE_STORAGE" >/dev/null 2>&1 \
    || die "Template storage not found or unavailable: $TEMPLATE_STORAGE"

# Verify VNet exists.
pvesh get "/cluster/sdn/vnets/${VNET}" --output-format json >/dev/null 2>&1 \
    || die "SDN VNet not found: $VNET"

if pct status "$VMID" >/dev/null 2>&1; then
    if [[ "$FORCE" != "yes" ]]; then
        die "CT $VMID already exists. Use --force to replace it."
    fi
    log "Removing existing CT $VMID..."
    pct stop "$VMID" --skiplock 1 >/dev/null 2>&1 || true
    pct destroy "$VMID" --purge 1
fi

STATE_BASE="/var/lib/mslsetup/dhcp"
STATE_DIR="${STATE_BASE}/${VNET}"
STATE_FILE="${STATE_DIR}/dhcp.env"
OVERRIDE_DIR="${STATE_BASE}/overrides"
OVERRIDE_FILE="${OVERRIDE_DIR}/${VNET}.env"

# Host-side export is singleton and CT-ID-free.
# It watches Proxmox SDN subnet configuration once and exports dhcp.env for all
# VNets that have DHCP ranges. Each DHCP CT watches only its own mounted dhcp.env.
EXPORTER_SCRIPT="/usr/local/sbin/msl-dhcp-export-all"
SERVICE_NAME="msl-dhcp-export-all.service"
PATH_NAME="msl-dhcp-export-all.path"

mkdir -p "$STATE_DIR" "$OVERRIDE_DIR"
chown root:root /var/lib/mslsetup "$STATE_BASE" "$STATE_DIR" "$OVERRIDE_DIR" 2>/dev/null || true
chmod 0755 /var/lib/mslsetup "$STATE_BASE" "$STATE_DIR" "$OVERRIDE_DIR"

write_override_file() {
    local file="$1"
    local ct_ip_value="$2"
    local gw_value="$3"
    local dns_value="$4"

    tmp="$(mktemp "${file}.XXXXXX")"
    {
        printf '# Generated by %s. Used by msl-dhcp-export-all.\n' "$PROG"
        printf 'CT_IP_OVERRIDE=%q\n' "$ct_ip_value"
        printf 'GW_OVERRIDE=%q\n' "$gw_value"
        printf 'DHCP_DNS_OVERRIDE=%q\n' "$dns_value"
    } >"$tmp"
    chmod 0644 "$tmp"

    if [[ -f "$file" ]] && cmp -s "$tmp" "$file"; then
        rm -f "$tmp"
    else
        mv -f "$tmp" "$file"
    fi
}

# Select the CT address before installing the singleton exporter.
# The exporter itself does not choose CT addresses; it only renders dhcp.env
# for VNets that already have an override file. This keeps host-side runtime
# sync deterministic and prevents later DHCP edits from moving the CT address.
select_tmp="$(mktemp "${STATE_FILE}.select.XXXXXX")"
trap 'rm -f "$select_tmp"' EXIT
python3 - "$VNET" "$CT_IP" "$CT_GATEWAY" "$DNS_SERVER" >"$select_tmp" <<'PY_SELECT'
import ipaddress
import json
import subprocess
import sys

vnet, ct_override, gw_override, dhcp_dns_override = sys.argv[1:5]


def run_json(path):
    p = subprocess.run(
        ["pvesh", "get", path, "--output-format", "json"],
        check=True, text=True, stdout=subprocess.PIPE
    )
    return json.loads(p.stdout)


def parse_dhcp_ranges(row, vnet):
    if "dhcp-range" not in row or row.get("dhcp-range") in (None, []):
        return []
    value = row.get("dhcp-range")
    subnet_id = str(row.get("subnet") or row.get("id") or "unknown-subnet")
    if not isinstance(value, list):
        raise SystemExit(
            f"Unsupported DHCP range format on {vnet}/{subnet_id}: "
            "expected dhcp-range to be a list of objects."
        )
    out = []
    for idx, item in enumerate(value, start=1):
        if not isinstance(item, dict):
            raise SystemExit(
                f"Unsupported DHCP range item on {vnet}/{subnet_id} at index {idx}: "
                "expected object with start-address and end-address."
            )
        start = item.get("start-address")
        end = item.get("end-address")
        if not isinstance(start, str) or not isinstance(end, str) or not start or not end:
            raise SystemExit(
                f"Unsupported DHCP range item on {vnet}/{subnet_id} at index {idx}: "
                "expected string start-address and end-address."
            )
        out.append((start, end))
    return out


def quote(value):
    return repr(str(value))


data = run_json(f"/cluster/sdn/vnets/{vnet}/subnets")
if not isinstance(data, list):
    raise SystemExit(
        f"Unsupported Proxmox SDN subnet API format for {vnet}: expected a JSON array."
    )

candidates = []
for row in data:
    if not isinstance(row, dict):
        raise SystemExit(
            f"Unsupported Proxmox SDN subnet API format for {vnet}: expected each array item to be an object."
        )
    ranges = parse_dhcp_ranges(row, vnet)
    if not ranges:
        continue
    cidr = row.get("cidr")
    if not isinstance(cidr, str) or not cidr:
        subnet_id = str(row.get("subnet") or row.get("id") or "unknown-subnet")
        raise SystemExit(
            f"Unsupported Proxmox SDN subnet API format on {vnet}/{subnet_id}: expected non-empty string cidr."
        )
    candidates.append((row, cidr, ranges))

if not candidates:
    raise SystemExit(
        f"No DHCP range was found for VNet {vnet}. Configure Datacenter > SDN > VNets > Subnets > DHCP Ranges first."
    )
if len(candidates) > 1:
    raise SystemExit(
        f"Multiple IPv4 subnets with DHCP ranges exist on {vnet}; this deployer currently requires exactly one."
    )

row, cidr, ranges = candidates[0]
net = ipaddress.ip_network(cidr, strict=False)
if net.version != 4:
    raise SystemExit("Only IPv4 DHCP is supported by this script.")

gateway = gw_override or row.get("gateway") or row.get("gateway4")
if not gateway:
    raise SystemExit(f"No gateway is configured for subnet {cidr}.")
gateway_ip = ipaddress.ip_address(str(gateway).split("/", 1)[0])
if gateway_ip not in net:
    raise SystemExit(f"Gateway {gateway_ip} is outside {net}.")

dhcp_dns = dhcp_dns_override or str(gateway_ip)
dhcp_dns_ip = ipaddress.ip_address(str(dhcp_dns).split("/", 1)[0])
if dhcp_dns_ip.version != 4:
    raise SystemExit("Only IPv4 DNS server is supported by this script.")

normalized = []
for start, end in ranges:
    a, b = ipaddress.ip_address(start), ipaddress.ip_address(end)
    if a.version != 4 or b.version != 4 or a not in net or b not in net or int(a) > int(b):
        raise SystemExit(f"Invalid DHCP range: {start}-{end}")
    normalized.append((a, b))


def in_pool(ip):
    return any(int(a) <= int(ip) <= int(b) for a, b in normalized)

