RequiresMountsFor=/opt/msl-dhcp-source

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/msl-render-dnsmasq
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
UNIT

cat >/usr/local/sbin/msl-apply-dnsmasq <<'SCRIPT'
#!/usr/bin/env bash
set -Eeuo pipefail
/usr/local/sbin/msl-render-dnsmasq
systemctl restart dnsmasq
SCRIPT
chmod 0755 /usr/local/sbin/msl-apply-dnsmasq

cat >/etc/systemd/system/msl-apply-dnsmasq.service <<'UNIT'
