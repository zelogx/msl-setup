pct exec "$VMID" -- systemctl is-active --quiet nftables
pct exec "$VMID" -- systemctl is-active --quiet dnsmasq
pct exec "$VMID" -- dnsmasq --test
pct exec "$VMID" -- nft list ruleset
pct exec "$VMID" -- ss -lntup

if [[ "$START_CT" != "yes" ]]; then
    log "Stopping CT because --no-start was specified..."
    pct stop "$VMID"
