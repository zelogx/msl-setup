import ipaddress
import json
import os
import pathlib
import shlex
import subprocess
import sys
import tempfile

state_base = pathlib.Path(sys.argv[1])
override_dir = pathlib.Path(sys.argv[2])
require_vnet = sys.argv[3]


def run_json(path):
    p = subprocess.run(
        ["pvesh", "get", path, "--output-format", "json"],
        check=True, text=True, stdout=subprocess.PIPE
    )
    return json.loads(p.stdout)


def parse_dhcp_ranges(row, vnet):
    """Parse the exact Proxmox API shape observed on PVE 9.x.

    Supported shape only:
      "dhcp-range": [
        {"start-address": "x.x.x.x", "end-address": "x.x.x.x"},
        ...
      ]

    Missing or empty dhcp-range means this subnet is not served by this
    DHCP exporter. Any other shape is treated as an unsupported API format.
    """
    if "dhcp-range" not in row or row.get("dhcp-range") in (None, []):
        return []

    value = row.get("dhcp-range")
    subnet_id = str(row.get("subnet") or row.get("id") or "unknown-subnet")
    if not isinstance(value, list):
        raise ValueError(
            f"Unsupported DHCP range format on {vnet}/{subnet_id}: "
            "expected dhcp-range to be a list of objects."
        )

    out = []
    for idx, item in enumerate(value, start=1):
        if not isinstance(item, dict):
            raise ValueError(
                f"Unsupported DHCP range item on {vnet}/{subnet_id} at index {idx}: "
                "expected object with start-address and end-address."
            )
        start = item.get("start-address")
        end = item.get("end-address")
        if not isinstance(start, str) or not isinstance(end, str) or not start or not end:
            raise ValueError(
                f"Unsupported DHCP range item on {vnet}/{subnet_id} at index {idx}: "
                "expected string start-address and end-address."
            )
        out.append((start, end))
    return out


def load_override(vnet):
    path = override_dir / f"{vnet}.env"
    data = {
        "CT_IP_OVERRIDE": "",
        "GW_OVERRIDE": "",
        "DHCP_DNS_OVERRIDE": "",
    }
    if not path.exists():
        return data
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if key not in data:
            continue
        try:
            parsed = shlex.split(value, posix=True)
            data[key] = parsed[0] if parsed else ""
        except ValueError:
            data[key] = value.strip().strip("'\"")
    return data


def quote(value):
    return repr(str(value))


def discover_vnets():
    data = run_json("/cluster/sdn/vnets")
    rows = data if isinstance(data, list) else [data]
    names = set()
    for row in rows:
        if isinstance(row, dict):
            for key in ("vnet", "vnetid", "id"):
                value = row.get(key)
                if value:
                    names.add(str(value))
                    break
        elif isinstance(row, str):
            names.add(row)
    return sorted(names)


def collect_candidates(vnet):
    data = run_json(f"/cluster/sdn/vnets/{vnet}/subnets")
    if not isinstance(data, list):
        raise ValueError(
            f"Unsupported Proxmox SDN subnet API format for {vnet}: "
            "expected a JSON array."
        )

    candidates = []
    for row in data:
        if not isinstance(row, dict):
            raise ValueError(
                f"Unsupported Proxmox SDN subnet API format for {vnet}: "
                "expected each array item to be an object."
            )

        ranges = parse_dhcp_ranges(row, vnet)
        if not ranges:
            continue

        cidr = row.get("cidr")
        if not isinstance(cidr, str) or not cidr:
            subnet_id = str(row.get("subnet") or row.get("id") or "unknown-subnet")
            raise ValueError(
                f"Unsupported Proxmox SDN subnet API format on {vnet}/{subnet_id}: "
                "expected non-empty string cidr."
            )

        candidates.append((row, cidr, ranges))

    return candidates


def render_env(vnet, row, cidr, ranges, overrides):
    net = ipaddress.ip_network(cidr, strict=False)
    if net.version != 4:
        raise ValueError("Only IPv4 DHCP is supported by this script.")

    gateway = overrides["GW_OVERRIDE"] or row.get("gateway") or row.get("gateway4")
    if not gateway:
        raise ValueError(f"No gateway is configured for subnet {cidr}.")
    gateway_ip = ipaddress.ip_address(str(gateway).split("/", 1)[0])
    if gateway_ip not in net:
        raise ValueError(f"Gateway {gateway_ip} is outside {net}.")

    dhcp_dns = overrides["DHCP_DNS_OVERRIDE"] or str(gateway_ip)
    dhcp_dns_ip = ipaddress.ip_address(str(dhcp_dns).split("/", 1)[0])
    if dhcp_dns_ip.version != 4:
        raise ValueError("Only IPv4 DNS server is supported by this script.")

    normalized = []
    for start, end in ranges:
        a, b = ipaddress.ip_address(start), ipaddress.ip_address(end)
        if a.version != 4 or b.version != 4 or a not in net or b not in net or int(a) > int(b):
            raise ValueError(f"Invalid DHCP range: {start}-{end}")
        normalized.append((a, b))

    def in_pool(ip):
        return any(int(a) <= int(ip) <= int(b) for a, b in normalized)

    ct_override = overrides["CT_IP_OVERRIDE"]
    if not ct_override:
        raise ValueError(
            f"No CT_IP_OVERRIDE is configured for {vnet}. "
            "Create the DHCP CT for this VNet before exporting dhcp.env."
        )

    iface = ipaddress.ip_interface(
        ct_override if "/" in ct_override else f"{ct_override}/{net.prefixlen}"
    )
    ct_ip = iface.ip
    prefix = iface.network.prefixlen
    if iface.network.network_address != net.network_address or prefix != net.prefixlen:
        raise ValueError(f"CT address {iface} does not belong to {net}.")

    if ct_ip == gateway_ip:
        raise ValueError("CT IP conflicts with the subnet gateway.")
    if in_pool(ct_ip):
        # Not fatal: export continues with the current DHCP ranges as-is.
        # The CT-side renderer excludes CT_IP from the effective dnsmasq
        # range and posts its own motd warning. Aborting the export here
        # would instead leave this VNet's dhcp.env silently stale after a
        # later GUI DHCP-range edit.
        print(
            f"warning: {vnet}: CT_IP {ct_ip} is inside a DHCP allocation "
            "range; exporting anyway, the CT will exclude it at render time.",
            file=sys.stderr,
        )

    lines = [
        f"VNET={quote(vnet)}",
        f"CIDR={quote(str(net))}",
        f"PREFIX={quote(str(prefix))}",
        f"NETMASK={quote(str(net.netmask))}",
        f"GATEWAY={quote(str(gateway_ip))}",
        f"DHCP_DNS={quote(str(dhcp_dns_ip))}",
        f"CT_IP={quote(str(ct_ip))}",
        "DHCP_RANGES=" + quote(",".join(f"{a}-{b}" for a, b in normalized)),
        "",
    ]
    return "\n".join(lines)


def write_if_changed(vnet, content):
    state_dir = state_base / vnet
    state_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(state_dir, 0o755)
    state_file = state_dir / "dhcp.env"

    old = state_file.read_text(encoding="utf-8") if state_file.exists() else None
    if old == content:
        print(f"unchanged: {vnet}")
        return False

    fd, tmp_name = tempfile.mkstemp(prefix="dhcp.env.", dir=str(state_dir), text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        os.chmod(tmp_name, 0o644)
        os.replace(tmp_name, state_file)
        print(f"updated: {vnet}")
        return True
    finally:
        try:
            os.unlink(tmp_name)
        except FileNotFoundError:
            pass


errors = []
exported = set()
for vnet in discover_vnets():
    try:
        overrides = load_override(vnet)
        if not overrides["CT_IP_OVERRIDE"]:
            if vnet == require_vnet:
                errors.append(f"No CT_IP_OVERRIDE is configured for required VNet {vnet}.")
            continue

        candidates = collect_candidates(vnet)
        if not candidates:
            if vnet == require_vnet:
                errors.append(f"No DHCP range was found for VNet {vnet}. Configure Datacenter > SDN > VNets > Subnets > DHCP Ranges first.")
            continue
        if len(candidates) > 1:
            msg = f"Multiple IPv4 subnets with DHCP ranges exist on {vnet}; this deployer currently requires exactly one."
            if vnet == require_vnet:
                errors.append(msg)
            else:
                print(f"warning: {msg}", file=sys.stderr)
            continue

        row, cidr, ranges = candidates[0]
        content = render_env(vnet, row, cidr, ranges, overrides)
        write_if_changed(vnet, content)
        exported.add(vnet)
    except Exception as e:
        msg = f"{vnet}: {e}"
        if vnet == require_vnet:
            errors.append(msg)
        else:
            print(f"warning: {msg}", file=sys.stderr)

if require_vnet and require_vnet not in exported and not errors:
    errors.append(f"No DHCP export was produced for required VNet {require_vnet}.")

if errors:
    for e in errors:
        print(f"error: {e}", file=sys.stderr)
    raise SystemExit(1)
PY_EXPORTER
EOF_EXPORTER
